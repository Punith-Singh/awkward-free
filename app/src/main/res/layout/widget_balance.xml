<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="YOU’RE OWED" android:textColor="#D2C9FF" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Open Awkward-Free" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/widget_open_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Open tabs" android:textColor="#DCD5FF" android:textSize="12sp" />
    <TextView android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:paddingHorizontal="12dp" android:paddingVertical="6dp"
        android:background="@drawable/widget_button" android:text="+ Add due" android:textColor="#241D50" android:textStyle="bold" />
</LinearLayout>
